<% set_breadcrumbs ["HOME", root_path], ["MY PAGE", mypage_path], ["EDIT PROFILE", nil] %>

<section class="w-100 py-5" style="background-color: var(--cinema-bg);">
  <div class="container">

    <div class="row">
      <div class="col-12 col-md-7 col-lg-5">

        <p class="small mb-2">ACCOUNT</p>

        <h1 class="fw-bold mb-5" style="color: var(--cinema-accent);">
          EDIT PROFILE
        </h1>

        <%= form_with model: @user do |f| %>

          <div class="mb-4">
            <%= f.label :name, "USER NAME",class: "form-label small fw-bold" %>
            <%= f.text_field :name,
                class: "form-control rounded-0 border-dark py-3" %>
          </div>

          <div class="mb-5">
            <%= f.label :email_address, "EMAIL",class: "form-label small fw-bold" %>
            <%= f.email_field :email_address,
                class: "form-control rounded-0 border-dark py-3" %>
          </div>

          <%= f.submit "SAVE CHANGES",class: "btn rounded-0 border-dark px-5 py-2",
              style: "background-color: var(--cinema-accent); color: var(--cinema-light);" %>

        <% end %>

        <div class="border-top border-dark mt-5 pt-4">
          <p class="small fw-bold mb-3">DELETE ACCOUNT</p>

          <%= button_to "退会する",
              withdraw_user_path(@user),
              method: :patch,
              data: { turbo_confirm: "本当に退会しますか？" },
              class: "btn btn-outline-dark rounded-0 px-4" %>
          
          <p class="small mt-3 mb-0">
            退会すると、このアカウントは利用できなくなります。<br>
            退会後も、Shout・Note・Q&Aなどの投稿データは残ります。<br>
            投稿データの削除をご希望の場合は、別途削除申請が必要です。
          </p>
        </div>

      </div>
    </div>

  </div>
</section>