<h1>プロフィール編集</h1>

<%= form_with model: @user do |f| %>
  <div>
    <%= f.label :name, "ユーザー名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email_address, "メールアドレス" %>
    <%= f.email_field :email_address %>
  </div>

  <%= f.submit "更新" %>
<% end %>

<%= button_to "退会する",
              withdraw_user_path(@user),
              method: :patch,
              data: { turbo_confirm: "本当に退会しますか？" } %>