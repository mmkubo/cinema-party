<% set_breadcrumbs ["HOME", root_path],["MY PAGE", nil] %>

<section class="w-100 py-5" style="background-color: var(--cinema-bg);">
  <div class="container">

    <h1 class="fw-bold mb-5" style="color: var(--cinema-accent);">MY PAGE</h1>

    <div class="d-flex justify-content-between align-items-end 
      border-bottom border-dark pb-4 mb-5">

      <div>
        <h2 class="fs-2 fw-bold mb-2"><%= @user.name %></h2>
        <p class="mb-0"><%= @user.email_address %></p>
      </div>

      <%= link_to "EDIT PROFILE", 
          edit_user_path(@user), class: "btn btn-outline-dark rounded-0 px-3 py-2" %>
    
    </div>

    <div class="border-bottom border-dark py-4">

      <div class="row">
        <div class="col-2">
          <span class="fs-4 fw-bold">01</span>
        </div>

        <div class="col-10">
          <h2 class="fs-3 fw-bold mb-3">WATCH LIST</h2>
          <p class="mb-0">観る予定の映画はまだありません。</p>
        </div>
      </div>

    </div>

    <div class="border-bottom border-dark py-4">

      <div class="row">
        <div class="col-2">
          <span class="fs-4 fw-bold">02</span>
        </div>

        <div class="col-10">
          <h2 class="fs-3 fw-bold mb-3">Note</h2>

          <% if @notes.any? %>
            <% @notes.each do |note| %>
              <div class="border-bottom border-dark py-3">

                <p class="small mb-1"><%= note.movie.title %></p>

                <div class="d-flex align-items-baseline flex-wrap">
                  <%= link_to note.title,note_path(note),
                      class: "fw-bold fs-5 text-dark text-decoration-none" %>

                  <span class="small ms-4"><%= note.created_at.strftime("%Y.%m.%d") %></span>
                </div>

              </div>
            <% end %>

          <% else %>
            <p class="mb-0">投稿したNoteはまだありません。</p>
          <% end %>
        </div>
      </div>

    </div>

    <div class="border-bottom border-dark py-4">

      <div class="row">
        <div class="col-2">
          <span class="fs-4 fw-bold">03</span>
        </div>

        <div class="col-10">
          <h2 class="fs-3 fw-bold mb-3">Q&A</h2>
          <p class="mb-0">投稿したQ&Aはまだありません。</p>
        </div>
      </div>

    </div>

  </div>
</section>