<section class="w-100 py-5" style="background-color: var(--cinema-bg);">
  <div class="container">

    <h1 class="fw-bold mb-4" style="color: var(--cinema-accent);">
      MOVIES
    </h1>

    <p class="mb-3"><%= pluralize(@movies.count, "MOVIE") %></p>

    <div class="border-top border-dark">

      <% @movies.each do |movie| %>
        <%= link_to movie_path(movie),
            class: "d-block text-decoration-none text-dark border-bottom border-dark py-4" do %>

          <div class="row align-items-center">

            <div class="col-2">
              <span class="small">MOVIE</span>
            </div>

            <div class="col-10">
              <h2 class="fs-3 fw-bold mb-2"><%= movie.title %></h2>

              <p class="mb-0">
                <%= movie.release_date.year %> / <%= movie.director %>
              </p>
            </div>

          </div>
        <% end %>
      <% end %>

    </div>

  </div>
</section>