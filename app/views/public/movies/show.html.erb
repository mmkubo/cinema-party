<section class="w-100 py-5" style="background-color: var(--cinema-bg);">
  <div class="container">

    <div class="row g-5">

      <div class="col-12 col-lg-5">

        <p class="small mb-2">MOVIE</p>
        <h1 class="display-4 fw-bold mb-5" style="color: var(--cinema-accent);">
          <%= @movie.title %>
        </h1>

        <div class="border-top border-dark">
          <div class="d-flex justify-content-between border-bottom border-dark py-3">
            <span>RELEASE</span>
            <span><%= @movie.release_date %></span>
          </div>
          <div class="d-flex justify-content-between border-bottom border-dark py-3">
            <span>DIRECTOR</span>
            <span><%= @movie.director %></span>
          </div>
        </div>

        <div class="mt-5">
          <h2 class="fs-6 fw-bold mb-3">PLOT</h2>
          <p class="lh-lg"><%= @movie.plot_summary %></p>
        </div>
      
      </div>

      <div class="col-12 col-lg-7">

        <div class=
          "d-flex justify-content-between align-items-end border-bottom border-dark pb-3">

          <h2 class="display-6 fw-bold mb-0">Shout</h2>
          <span class="small"><%= @shouts.count %> SHOUTS </span>
        
        </div>

        <% if authenticated_user? %>

          <%= form_with model: [@movie, @shout], class: "my-4" do |f| %>
            <%= f.text_area :body, class: "form-control rounded-0 border-dark",
                rows: 3, placeholder: "この映画について叫ぶ", required: true %>

            <div class="d-flex justify-content-end mt-2">
              <%= f.submit "Shout", class: "btn rounded-0 border-dark px-4",
                  style: "background-color: var(--cinema-accent); color: var(--cinema-light);" %>
            </div>
          <% end %>

        <% else %>
          <p class="my-4">ログインが必要です。</p>
        <% end %>

        <div class="border-top border-dark">

          <% @shouts.each do |shout| %>
            <div class="border-bottom border-dark py-2">
              <div class="d-flex justify-content-between align-items-center mb-2">

                <div class="d-flex align-items-center gap-3">
                  <%= link_to shout.user.name,user_path(shout.user),
                      class: "fw-bold text-dark text-decoration-none" %>
                  <span class="small">
                    <%= time_ago_in_words(shout.created_at).sub("about ", "") %> ago
                  </span>
                </div>

                <% if Current.user == shout.user %>
                  <%= button_to "削除",
                      shout_path(shout),
                      method: :delete,
                      data: { turbo_confirm: "削除しますか？" },
                      class: "btn btn-sm btn-outline-dark rounded-0" %>
                <% end %>
              </div>
              
              <p class="mb-0 ms-2"><%= shout.body %></p>
            </div>
          <% end %>

        </div>

      </div>

    </div>

    <div class="border-top border-dark mt-5 pt-4">
      <h2 class="display-6 fw-bold mb-0">Note</h2>
    </div>

  </div>
</section>
