<% set_breadcrumbs ["HOME", root_path],["MOVIES", movies_path],
                   [@movie.title, movie_path(@movie)],["NEW NOTE", nil] %>

<section class="w-100 py-5" style="background-color: var(--cinema-bg);">
  <div class="container">

    <div class="row">

      <%= render "movie_info", movie: @movie %>

      <div class="col-12 col-lg-7 offset-lg-1">

        <p class="small mb-2">WRITE ABOUT</p>

        <h1 class="fw-bold mb-5" style="color: var(--cinema-accent);">
          NEW NOTE
        </h1>

        <% if @note.errors.any? %>
          <div class="border border-dark p-3 mb-4">
            <p class="fw-bold mb-2">入力内容を確認してください</p>

            <ul class="mb-0">
              <% @note.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: [@movie, @note] do |f| %>

          <div class="mb-4">
            <%= f.label :title, "TITLE",
                class: "form-label small fw-bold" %>

            <%= f.text_field :title,
                class: "form-control rounded-0 border-dark py-3",
                placeholder: "Noteのタイトル" %>
          </div>

          <div class="mb-5">
            <%= f.label :body, "NOTE",
                class: "form-label small fw-bold" %>

            <%= f.text_area :body,
                class: "form-control rounded-0 border-dark py-3",
                rows: 10,
                placeholder: "映画についてじっくり書いてみよう" %>
          </div>

          <%= f.submit "POST NOTE",
              class: "btn rounded-0 border-dark px-5 py-2",
              style: "background-color: var(--cinema-accent); color: var(--cinema-light);" %>

        <% end %>

      </div>
    </div>

  </div>
</section>