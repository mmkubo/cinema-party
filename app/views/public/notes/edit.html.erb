<% set_breadcrumbs ["HOME", root_path],["MOVIES", movies_path],
                   [@note.movie.title, movie_path(@note.movie)],
                   [@note.title, note_path(@note)],["EDIT", nil] %>

<%= turbo_frame_tag dom_id(@note) do %>

  <p class="small mb-2">NOTE</p>

  <h1 class="fw-bold mb-5" style="color: var(--cinema-accent);">
    EDIT NOTE
  </h1>

  <% if @note.errors.any? %>
    <div class="border border-dark p-3 mb-4">
      <p class="fw-bold mb-2">入力内容を確認してください</p>

      <ul class="mb-0">
        <% @note.errors.each do |error| %>
          <li>
            <%= error.attribute == :title ? "タイトルを入力してください" : "本文を入力してください" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @note do |f| %>

    <div class="mb-4">
      <%= f.label :title, "TITLE",
          class: "form-label small fw-bold" %>

      <%= f.text_field :title,
          class: "form-control rounded-0 border-dark py-3" %>
    </div>

    <div class="mb-5">
      <%= f.label :body, "NOTE",
          class: "form-label small fw-bold" %>

      <%= f.text_area :body,
          class: "form-control rounded-0 border-dark py-3",
          rows: 10 %>
    </div>

    <div class="d-flex gap-3">
      <%= f.submit "UPDATE NOTE",
          class: "btn rounded-0 border-dark px-5 py-2",
          style: "background-color: var(--cinema-accent); color: var(--cinema-light);" %>

      <%= link_to "CANCEL",
          note_path(@note),
          class: "btn btn-outline-dark rounded-0 px-4" %>
    </div>

  <% end %>

<% end %>